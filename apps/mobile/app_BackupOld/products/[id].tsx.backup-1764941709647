import React, { useEffect, useState } from "react";
import {
  View,
  Text,
  ScrollView,
  Image,
  TouchableOpacity,
  ActivityIndicator,
  StyleSheet,
  Alert,
  Share,
} from "react-native";
import { Ionicons } from "@expo/vector-icons";
import { useLocalSearchParams, useRouter } from "expo-router";
import { doc, getDoc } from "firebase/firestore";
import { db } from "../../src/config/firebase";
import { useCart } from "../../src/contexts/CartContext";

export default function ProductDetailScreen() {
  const { id } = useLocalSearchParams<{ id: string }>();
  const router = useRouter();
  const { addToCart } = useCart();

  const [product, setProduct] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [isFavorite, setIsFavorite] = useState(false);

  // 🧠 Récupération du produit depuis Firestore
  useEffect(() => {
    const fetchProduct = async () => {
      try {
        const ref = doc(db, "products", id!);
        const snap = await getDoc(ref);
        if (snap.exists()) {
          setProduct({ id: snap.id, ...snap.data() });
        } else {
          Alert.alert("Produit introuvable", "Ce produit n’existe pas.");
        }
      } catch (error) {
        console.error("Erreur récupération produit:", error);
      } finally {
        setLoading(false);
      }
    };

    fetchProduct();
  }, [id]);

  if (loading) {
    return (
      <View style={styles.center}>
        <ActivityIndicator size="large" color="#ff6a00" />
        <Text style={{ marginTop: 10 }}>Chargement du produit...</Text>
      </View>
    );
  }

  if (!product) {
    return (
      <View style={styles.center}>
        <Text>Produit introuvable.</Text>
      </View>
    );
  }

  // 🔍 Récupération intelligente de l'image principale
  const getProductImage = () => {
    return (
      product.image ||
      product.imageUrl ||
      product.photoUrl ||
      product.media?.main ||
      product.images?.[0] ||
      "https://via.placeholder.com/300x300.png?text=Assma+Express"
    );
  };

  const handleAddToCart = () => {
    addToCart(product);
    Alert.alert("✅ Ajouté au panier", `${product.name} ajouté avec succès.`);
  };

  const handleShare = async () => {
    try {
      await Share.share({
        message: `${product.name} - Disponible sur Assma Express à ${product.price} F CFA`,
        url: `https://assmaexpress.com/products/${product.id}`,
      });
    } catch (error) {
      console.error("Erreur partage:", error);
    }
  };

  return (
    <ScrollView style={styles.container}>
      {/* Header minimal */}
      <View style={styles.header}>
        <TouchableOpacity onPress={() => router.back()} style={styles.headerButton}>
          <Ionicons name="arrow-back" size={24} color="#333" />
        </TouchableOpacity>

        <View style={styles.headerActions}>
          <TouchableOpacity onPress={handleShare}>
            <Ionicons name="share-outline" size={24} color="#333" />
          </TouchableOpacity>
          <TouchableOpacity onPress={() => setIsFavorite(!isFavorite)}>
            <Ionicons
              name={isFavorite ? "heart" : "heart-outline"}
              size={24}
              color={isFavorite ? "#ff4444" : "#333"}
            />
          </TouchableOpacity>
        </View>
      </View>

      {/* Image du produit */}
      <Image source={{ uri: getProductImage() }} style={styles.image} />

      {/* Détails produit */}
      <View style={styles.details}>
        <Text style={styles.name}>{product.name}</Text>
        {product.price && (
          <Text style={styles.price}>{product.price} F CFA</Text>
        )}
        {product.description && (
          <Text style={styles.desc}>{product.description}</Text>
        )}
      </View>

      {/* Boutons d’action */}
      <View style={styles.actions}>
        <TouchableOpacity style={[styles.btn, styles.cartBtn]} onPress={handleAddToCart}>
          <Ionicons name="cart-outline" size={18} color="#fff" />
          <Text style={styles.btnText}>Ajouter au panier</Text>
        </TouchableOpacity>

        <TouchableOpacity
          style={[styles.btn, styles.buyBtn]}
          onPress={() => Alert.alert("🛍️ Achat", "Fonction Achat immédiat à venir.")}
        >
          <Text style={styles.btnText}>Acheter maintenant</Text>
        </TouchableOpacity>
      </View>
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: "#fff" },
  center: { flex: 1, justifyContent: "center", alignItems: "center" },
  header: {
    flexDirection: "row",
    justifyContent: "space-between",
    alignItems: "center",
    padding: 12,
  },
  headerButton: { padding: 4 },
  headerActions: { flexDirection: "row", gap: 10 },
  image: {
    width: "100%",
    height: 300,
    resizeMode: "contain",
    backgroundColor: "#f5f5f5",
  },
  details: { padding: 16 },
  name: { fontSize: 18, fontWeight: "700", color: "#222", marginBottom: 6 },
  price: { fontSize: 16, color: "#ff6a00", fontWeight: "700", marginBottom: 10 },
  desc: { fontSize: 14, color: "#555", lineHeight: 20 },
  actions: {
    flexDirection: "row",
    paddingHorizontal: 16,
    paddingBottom: 30,
    gap: 10,
  },
  btn: {
    flex: 1,
    paddingVertical: 12,
    borderRadius: 8,
    alignItems: "center",
    justifyContent: "center",
    flexDirection: "row",
    gap: 8,
  },
  cartBtn: { backgroundColor: "#ff6a00" },
  buyBtn: { backgroundColor: "#333" },
  btnText: { color: "#fff", fontWeight: "600", fontSize: 15 },
});
