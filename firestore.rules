rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers (source : custom claim Auth uniquement) ──────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function tokenRole() {
      return isSignedIn() ? request.auth.token.role : null;
    }

    function isSuperAdmin() {
      return isSignedIn() && tokenRole() in ['super-admin', 'super_admin'];
    }

    function isAdmin() {
      return isSignedIn() && tokenRole() == 'admin';
    }

    function isStaff() {
      return isSuperAdmin() || isAdmin();
    }

    function isSeller() {
      return isSignedIn() && tokenRole() == 'seller';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Un document sans champ role vaut 'customer'. Sans ce défaut, l'absence de
    // champ était lue comme « inchangé », ce qui laissait y écrire super-admin.
    function effectiveRole(data) {
      return 'role' in data ? data.role : 'customer';
    }

    // Interdit toute modification client du champ role (setUserRole = Admin SDK)
    function roleUnchanged() {
      return effectiveRole(request.resource.data) == effectiveRole(resource.data);
    }

    function orderBelongsToUser(data) {
      return isSignedIn() && (
        data.userId == request.auth.uid
        || data.sellerId == request.auth.uid
        || (data.sellerIds is list && request.auth.uid in data.sellerIds)
      );
    }

    function productBelongsToSeller(data) {
      return isSignedIn() && (
        data.sellerId == request.auth.uid
        || data.companyId == request.auth.uid
      );
    }

    // ── users ────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Vendeur : retrouver l'acheteur d'une commande (téléphone / nom)
      allow read: if isOwner(uid) || isStaff() || isSeller();
      allow create: if isOwner(uid)
        && (!('role' in request.resource.data)
            || request.resource.data.role in ['customer', 'seller']);
      allow update: if (
          (isOwner(uid) && roleUnchanged())
          || isStaff()
        )
        && (isSuperAdmin() || roleUnchanged());
      allow delete: if isSuperAdmin();

      // Panier cloud : users/{uid}/data/cart
      match /data/{docId} {
        allow read, write: if isOwner(uid) || isStaff();
      }

      match /favorites/{favId} {
        allow read, write: if isOwner(uid) || isStaff();
      }
    }

    // ── lives (écoute accueil + chat / viewers) ──────────────────────────
    function onlyLiveCounters() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['viewersCount', 'likesCount', 'giftsCount']);
    }

    match /lives/{liveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.hostId == request.auth.uid;
      allow update: if isStaff()
        || (isSignedIn() && resource.data.hostId == request.auth.uid)
        || (isSignedIn() && onlyLiveCounters());
      allow delete: if isStaff()
        || (isSignedIn() && resource.data.hostId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isStaff();
      }

      match /viewers/{viewerId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn();
        allow delete: if isStaff() || isOwner(viewerId);
      }
    }

    // ── orders (staff + propriétaire / vendeur) ──────────────────────────
    // Champs posés exclusivement par le backend de paiement via l'Admin SDK,
    // qui n'est pas soumis à ces règles. Aucun client ne doit pouvoir les écrire.
    function paymentFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['paymentStatus', 'paidAt', 'total']);
    }

    function noPaymentFieldsAtCreate() {
      return !request.resource.data.keys()
        .hasAny(['paymentStatus', 'paidAt', 'total']);
    }

    match /orders/{orderId} {
      allow read: if isStaff() || orderBelongsToUser(resource.data);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && noPaymentFieldsAtCreate();
      allow update: if (isStaff() || orderBelongsToUser(resource.data))
        && paymentFieldsUnchanged();
      allow delete: if isSuperAdmin();
    }

    // ── products (catalogue public + staff + vendeur propriétaire) ───────
    match /products/{productId} {
      allow read: if true;
      allow create: if isStaff()
        || (isSeller() && productBelongsToSeller(request.resource.data));
      allow update: if isStaff()
        || (isSeller()
            && productBelongsToSeller(resource.data)
            && productBelongsToSeller(request.resource.data));
      allow delete: if isStaff()
        || (isSeller() && productBelongsToSeller(resource.data));
    }

    // ── companies / fournisseurs ─────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isStaff() || isOwner(companyId);
      allow update: if isStaff() || isOwner(companyId);
      allow delete: if isSuperAdmin();
    }

    // ── support / tickets ────────────────────────────────────────────────
    match /supportTickets/{ticketId} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isStaff();
    }

    // ── config / settings (super-admin seul en écriture) ─────────────────
    match /config/{docId} {
      // exchangeRates : lu par le formulaire vendeur (aucun secret)
      allow read: if isStaff() || docId == 'exchangeRates';
      allow write: if isSuperAdmin();
    }

    // ── conversations : création seulement si le routage est valide ────────
    match /conversations/{conversationId} {
      function supportInboxUid() {
        return 'biU1QvlrGtZeqTLdbLONLGbyVQ92';
      }

      function participantListOk() {
        let parts = request.resource.data.participants;
        let client = request.resource.data.clientUid;
        let seller = request.resource.data.sellerUid;
        return parts is list
          && client is string
          && seller is string
          && client.size() > 0
          && seller.size() > 0
          && client in parts
          && seller in parts
          && request.auth.uid in parts
          && (request.auth.uid == client || request.auth.uid == seller)
          && (
            (client == seller && parts.size() == 1)
            || (client != seller && parts.size() == 2)
          );
      }

      function storeOwnerOk() {
        let company = get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data;
        let seller = request.resource.data.sellerUid;
        let companyId = request.resource.data.companyId;
        let explicitOwner = ('ownerUid' in company && company.ownerUid == seller)
          || ('ownerId' in company && company.ownerId == seller)
          || ('sellerUid' in company && company.sellerUid == seller);
        let noExplicitOwner = !('ownerUid' in company)
          && !('ownerId' in company)
          && !('sellerUid' in company);
        let accountPath = /databases/$(database)/documents/users/$(companyId);
        let verifiedOwner = exists(accountPath) && (
          get(accountPath).data.role == 'seller'
          || get(accountPath).data.role == 'admin'
          || get(accountPath).data.role == 'super-admin'
          || get(accountPath).data.role == 'super_admin'
        );
        let shopAccount = noExplicitOwner && verifiedOwner && seller == companyId;
        let uidWhenDocIsNotAccount = noExplicitOwner
          && !verifiedOwner
          && ('uid' in company && company.uid == seller);
        return companyId is string
          && companyId.size() > 0
          && (explicitOwner || shopAccount || uidWhenDocIsNotAccount)
          && (seller != supportInboxUid() || seller == companyId);
      }

      function supportCreateOk() {
        return request.resource.data.sellerUid == supportInboxUid()
          && request.resource.data.clientUid != supportInboxUid()
          && participantListOk();
      }

      function storeCreateOk() {
        return storeOwnerOk() && participantListOk();
      }

      // Un champ absent des deux côtés compte comme inchangé.
      // Lire un champ manquant (anciens fils sans conversationKind) ferait échouer la règle.
      function sameOrBothMissing(field) {
        let beforeHas = field in resource.data;
        let afterHas = field in request.resource.data;
        return (!beforeHas && !afterHas)
          || (beforeHas && afterHas && resource.data[field] == request.resource.data[field]);
      }

      function routingFrozen() {
        return sameOrBothMissing('conversationKind')
          && sameOrBothMissing('clientUid')
          && sameOrBothMissing('sellerUid')
          && sameOrBothMissing('participants')
          && sameOrBothMissing('companyId');
      }

      // Répare seulement un fil déjà là : ajoute conversationKind, sans changer le destinataire.
      function fillsMissingKindOnly() {
        return !('conversationKind' in resource.data)
          && request.resource.data.conversationKind is string
          && sameOrBothMissing('clientUid')
          && sameOrBothMissing('sellerUid')
          && sameOrBothMissing('participants')
          && sameOrBothMissing('companyId')
          && (
            (request.resource.data.conversationKind == 'customer_to_support' && supportCreateOk())
            || (
              (request.resource.data.conversationKind == 'customer_to_store'
                || request.resource.data.conversationKind == 'seller_to_customer')
              && storeCreateOk()
            )
          );
      }

      function isThreadParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      allow read: if isThreadParticipant();
      allow create: if isSignedIn() && (
        (request.resource.data.conversationKind == 'customer_to_support' && supportCreateOk())
        || (request.resource.data.conversationKind == 'customer_to_store' && storeCreateOk())
        || (request.resource.data.conversationKind == 'seller_to_customer' && storeCreateOk())
      );
      allow update: if isThreadParticipant() && (routingFrozen() || fillsMissingKindOnly());
      allow delete: if isStaff();

      match /messages/{messageId} {
        function inThread() {
          return isSignedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }

        allow read: if inThread();
        allow create: if inThread()
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if inThread();
      }

      match /typing/{uid} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── collections publiques / catalogue ────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isStaff()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── tokens push (propriétaire) ───────────────────────────────────────
    match /pushTokens/{tokenId} {
      allow read, write: if isSignedIn();
    }

    // ── embeddings / index internes (lecture staff, écriture CF) ────────
    match /product_image_embeddings/{docId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /product_updates/{docId} {
      allow read: if isStaff() || isSeller();
      allow create: if isStaff() || isSeller();
      allow update, delete: if isStaff();
    }

    // ── Refus explicite du reste ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
