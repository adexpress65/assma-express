// Fonction utilitaire pour formater l'heure
const formatTime = (timestamp: any): string => {
  if (!timestamp) return '';
  
  try {
    const date = timestamp.toDate ? timestamp.toDate() : new Date(timestamp);
    return date.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
  } catch (error) {
    return '';
  }
};

// COMPOSANT MESSAGE OPTIMISÉ - CORRIGÉ
const MessageItem = memo(({ 
  item, 
  index, 
  allMessages,
  userId 
}: { 
  item: any; 
  index: number;
  allMessages: any[];
  userId: string;
}) => {
  const isMe = item.senderId === userId;
  const isSystem = item.type === "system";
  
  const showTime = index === allMessages.length - 1 || 
    (index < allMessages.length - 1 && (
      item.senderId !== (allMessages[index + 1]?.senderId || "") ||
      formatTime(item.timestamp) !== formatTime(allMessages[index + 1]?.timestamp || "")
    ));

  if (isSystem) {
    return (
      <View style={styles.systemMessage}>
        <Text style={styles.systemText}>{item.text}</Text>
        <Text style={styles.systemTime}>{formatTime(item.timestamp)}</Text>
      </View>
    );
  }

  return (
    <View style={[styles.messageContainer, { 
      justifyContent: isMe ? "flex-end" : "flex-start" 
    }]}>
      <View style={[styles.messageBubble, isMe ? styles.myMessage : styles.theirMessage]}>
        <Text style={[styles.messageText, isMe && styles.myMessageText]}>
          {item.text}
        </Text>
        
        {showTime && (
          <View style={styles.messageFooter}>
            <Text style={[
              styles.messageTime, 
              isMe ? styles.myMessageTime : styles.theirMessageTime
            ]}>
              {formatTime(item.timestamp)}
            </Text>
            {isMe && (
              <View style={styles.messageStatus}>
                <Ionicons 
                  name={item.read ? "checkmark-done" : "checkmark"} 
                  size={12} 
                  color={item.read ? "#007AFF" : "rgba(255,255,255,0.5)"} 
                />
              </View>
            )}
          </View>
        )}
      </View>
    </View>
  );
});

// COMPOSANT HEADER OPTIMISÉ
const ConversationHeader = memo(({ 
  conversation, 
  onBack 
}: { 
  conversation?: any; 
  onBack: () => void;
}) => {
  const getAvatar = (conv: any) => {
    if (conv.type === 'support') return '🛒';
    if (conv.type === 'order') return '📦';
    return conv.participantAvatars?.[Object.keys(conv.participantAvatars || {})[0]] || '👤';
  };

  const getStatus = (conv: any) => {
    if (conv.type === 'support') return 'Support en ligne';
    if (conv.type === 'order') return 'Commande active';
    return 'En ligne';
  };

  return (
    <View style={styles.header}>
      <TouchableOpacity onPress={onBack} style={styles.backButton}>
        <Ionicons name="arrow-back" size={24} color="#000" />
      </TouchableOpacity>

      {conversation ? (
        <TouchableOpacity style={styles.headerCenter}>
          <View style={styles.avatarContainer}>
            <Text style={styles.headerAvatar}>{getAvatar(conversation)}</Text>
            <View style={styles.onlineDot} />
          </View>
          <View style={styles.headerInfo}>
            <Text style={styles.headerTitle}>{conversation.title}</Text>
            <Text style={styles.headerSubtitle}>
              {getStatus(conversation)} • {conversation.type}
            </Text>
          </View>
        </TouchableOpacity>
      ) : (
        <Text style={styles.headerTitle}>Conversation</Text>
      )}

      <View style={styles.headerActions}>
        <TouchableOpacity style={styles.headerAction}>
          <Ionicons name="videocam" size={22} color="#007AFF" />
        </TouchableOpacity>
        <TouchableOpacity style={styles.headerAction}>
          <Ionicons name="call" size={22} color="#007AFF" />
        </TouchableOpacity>
      </View>
    </View>
  );
});

// COMPOSANT INPUT OPTIMISÉ
const MessageInput = memo(({
  newMessage,
  onMessageChange,
  onSendMessage,
  onAttachPress,
}: {
  newMessage: string;
  onMessageChange: (text: string) => void;
  onSendMessage: () => void;
  onAttachPress: () => void;
}) => {
  const textInputRef = useRef<TextInput>(null);

  return (
    <View style={styles.inputContainer}>
      <View style={styles.inputWrapper}>
        <TouchableOpacity style={styles.plusButton} onPress={onAttachPress}>
          <Ionicons name="add" size={24} color="#007AFF" />
        </TouchableOpacity>
        
        <TextInput
          ref={textInputRef}
          style={styles.textInput}
          placeholder="Écrivez un message..."
          placeholderTextColor="#999"
          multiline
          value={newMessage}
          onChangeText={onMessageChange}
        />
        
        <View style={styles.inputActions}>
          <TouchableOpacity style={styles.actionButton}>
            <Ionicons name="camera-outline" size={22} color="#666" />
          </TouchableOpacity>
          <TouchableOpacity style={styles.actionButton}>
            <Ionicons name="image-outline" size={22} color="#666" />
          </TouchableOpacity>
        </View>
      </View>

      <TouchableOpacity
        style={[styles.sendButton, !newMessage.trim() && styles.sendButtonDisabled]}
        disabled={!newMessage.trim()}
        onPress={onSendMessage}
      >
        <Ionicons
          name="send"
          size={20}
          color={newMessage.trim() ? "#FFF" : "#AAA"}
        />
      </TouchableOpacity>
    </View>
  );
});

export default function ConversationDetailScreen() {
  const { id } = useLocalSearchParams();
  const router = useRouter();
  const insets = useSafeAreaInsets();
  const { user } = useAuth();
  const { 
    conversations, 
    messages, 
    sendMessage, 
    currentConversation, 
    setCurrentConversation,
    markAsRead 
  } = useMessages();

  const conversationId = Array.isArray(id) ? id[0] : id;
  
  const [newMessage, setNewMessage] = useState("");
  const [keyboardHeight, setKeyboardHeight] = useState(0);
  const [isKeyboardVisible, setIsKeyboardVisible] = useState(false);
  const [isSending, setIsSending] = useState(false);
  
  const flatListRef = useRef<FlatList>(null);

  // Trouver la conversation actuelle
  const conversation = conversations.find(conv => conv.id === conversationId) || currentConversation;

  // Définir la conversation courante
  useEffect(() => {
    if (conversationId && conversations.length > 0) {
      const foundConversation = conversations.find(conv => conv.id === conversationId);
      if (foundConversation) {
        setCurrentConversation(foundConversation);
      }
    }
  }, [conversationId, conversations]);

  // Marquer les messages comme lus
  useEffect(() => {
    if (conversationId && user) {
      markAsRead(conversationId);
    }
  }, [conversationId, user, messages.length]);

  // Gestion du clavier optimisée
  useEffect(() => {
    const keyboardDidShowListener = Keyboard.addListener(
      Platform.OS === 'ios' ? 'keyboardWillShow' : 'keyboardDidShow',
      (e) => {
        setIsKeyboardVisible(true);
        setKeyboardHeight(e.endCoordinates.height);
        
        setTimeout(() => {
          flatListRef.current?.scrollToEnd({ animated: true });
        }, 100);
      }
    );

    const keyboardDidHideListener = Keyboard.addListener(
      Platform.OS === 'ios' ? 'keyboardWillHide' : 'keyboardDidHide',
      () => {
        setIsKeyboardVisible(false);
        setKeyboardHeight(0);
      }
    );

    return () => {
      keyboardDidShowListener.remove();
      keyboardDidHideListener.remove();
    };
  }, []);

  // Scroll vers le bas quand de nouveaux messages arrivent
  useEffect(() => {
    if (messages.length > 0) {
      setTimeout(() => {
        flatListRef.current?.scrollToEnd({ animated: true });
      }, 100);
    }
  }, [messages.length]);

  // Callbacks mémoïsés
  const handleSendMessage = useCallback(async () => {
    if (!newMessage.trim() || !conversationId || !user || isSending) return;

    setIsSending(true);
    
    try {
      await sendMessage(conversationId, newMessage);
      setNewMessage("");
      
      setTimeout(() => {
        flatListRef.current?.scrollToEnd({ animated: true });
      }, 100);
    } catch (error) {
      console.error('Erreur envoi message:', error);
      Alert.alert('Erreur', 'Impossible d\'envoyer le message');
    } finally {
      setIsSending(false);
    }
  }, [newMessage, conversationId, user, isSending, sendMessage]);

  const handleMessageChange = useCallback((text: string) => {
    setNewMessage(text);
  }, []);

  const handleBack = useCallback(() => {
    setCurrentConversation(null);
    router.back();
  }, [router, setCurrentConversation]);

  const handleAttachPress = useCallback(() => {
    Alert.alert('Pièces jointes', 'Cette fonctionnalité sera disponible bientôt!');
  }, []);

  const dismissKeyboard = useCallback(() => {
    Keyboard.dismiss();
  }, []);

  const renderMessage = useCallback(({ item, index }: { item: any; index: number }) => (
    <MessageItem 
      item={item} 
      index={index} 
      allMessages={messages}
      userId={user?.uid || ''}
    />
  ), [messages, user]);

  const keyExtractor = useCallback((item: any) => item.id, []);

  const getItemLayout = useCallback((
    data: ArrayLike<any> | null | undefined, 
    index: number
  ) => ({
    length: 80,
    offset: 80 * index,
    index,
  }), []);

  if (!conversation) {
    return (
      <SafeAreaView style={styles.loadingContainer}>
        <ActivityIndicator size="large" color="#007AFF" />
        <Text style={styles.loadingText}>Chargement de la conversation...</Text>
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={styles.safeArea}>
      <StatusBar barStyle="dark-content" backgroundColor="#FFF" />
      
      <ConversationHeader 
        conversation={conversation} 
        onBack={handleBack}
      />

      <TouchableOpacity 
        style={styles.messagesArea} 
        activeOpacity={1}
        onPress={dismissKeyboard}
      >
        <FlatList
          ref={flatListRef}
          data={messages}
          keyExtractor={keyExtractor}
          renderItem={renderMessage}
          getItemLayout={getItemLayout}
          showsVerticalScrollIndicator={false}
          initialNumToRender={10}
          maxToRenderPerBatch={5}
          windowSize={5}
          removeClippedSubviews={Platform.OS === 'android'}
          contentContainerStyle={[
            styles.messagesContent,
            { 
              paddingBottom: 100 + insets.bottom + (isKeyboardVisible ? keyboardHeight : 0)
            }
          ]}
          onScrollBeginDrag={dismissKeyboard}
        />
      </TouchableOpacity>

      <KeyboardAvoidingView
        behavior={Platform.OS === "ios" ? "padding" : "height"}
        keyboardVerticalOffset={Platform.OS === "ios" ? 90 : 0}
        style={styles.keyboardAvoidingView}
      >
        <MessageInput
          newMessage={newMessage}
          onMessageChange={handleMessageChange}
          onSendMessage={handleSendMessage}
          onAttachPress={handleAttachPress}
        />
      </KeyboardAvoidingView>

      {isSending && (
        <View style={styles.sendingOverlay}>
          <ActivityIndicator size="small" color="#007AFF" />
          <Text style={styles.sendingText}>Envoi...</Text>
        </View>
      )}
    </SafeAreaView>
  );
}

